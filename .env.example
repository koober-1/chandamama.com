# Application
NEXT_PUBLIC_VERSION=
NEXT_PUBLIC_WEB_NAME=Chandaamama
NEXT_PUBLIC_BASE_URL=https://example.com

# Customer API
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_SUBURL=/customer

# Location and country
NEXT_PUBLIC_COUNTRY_DROPDOWN=true
NEXT_PUBLIC_MAP_API=
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=in
NEXT_PUBLIC_COUNTRY_DIAL_CODE=91

# Firebase web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Demo mode
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_LOGIN_NO=
NEXT_PUBLIC_DEMO_OTP=

# Build mode: false = static `out`; true = standalone Node server
NEXT_PUBLIC_SEO=false

# Search metadata
NEXT_PUBLIC_META_TITLE=
NEXT_PUBLIC_META_DESCRIPTION=
NEXT_PUBLIC_META_KEYWORDS=

